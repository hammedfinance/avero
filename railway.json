{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bun install",
    "nixpacksPlan": {
      "providers": [],
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_22", "bun"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "bun run server/index.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
